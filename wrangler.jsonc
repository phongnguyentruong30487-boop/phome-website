{
  "name": "phome-website",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  // Worker nhỏ chỉ xử lý /api/* (chatbot AI + ghi lead vào Google Sheet) — xem worker/index.ts
  "main": "worker/index.ts",
  // Static export (next.config.ts: output "export") → phục vụ ./out trực tiếp như trước
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Chỉ /api/* mới chạy qua Worker; mọi trang khác vẫn là file tĩnh (không tốn lượt Worker)
    "run_worker_first": ["/api/*"]
  },
  // Giới hạn mỗi IP 20 lượt / 60 giây cho /api/chat và /api/lead (chống spam, giữ chi phí AI)
  "ratelimits": [
    {
      "name": "CHAT_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
